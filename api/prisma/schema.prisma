generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// NEW MODELS (RBAC & System)
// ==========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  avatarColor   String?   @map("avatar_color")
  roleId        String    @map("role_id")
  role          Role      @relation(fields: [roleId], references: [id])
  isActive      Boolean   @default(true) @map("is_active")
  lastActiveAt  DateTime? @map("last_active_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  activities       LeadActivity[]
  systemActivities SystemActivity[]
  ownedDeals       Deal[]
  ownedLeads       Lead[]
  dealActivities   DealActivity[]
  
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  users       User[]
  permissions RolePermission[]
  
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  group       String
  roles       RolePermission[]
  
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ==========================================
// EXISTING TABLES (Preserved & Enhanced)
// ==========================================

/// This model contains row level security.
model Account {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String    @unique
  address        String?
  industry       String?
  annualRevenue  String?   @map("annual_revenue")
  employeesCount Int?      @default(0) @map("employees_count")
  ownership      String?
  status         String?   @default("Active")
  region         String?
  contactsCount  Int?      @default(0) @map("contacts_count")
  openLeads      Int?      @default(0) @map("open_leads")
  ltv            String?
  ownerInitials  String?    @map("owner_initials")
  createdAt      DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")

  // CRM Profile Fields (merged from crm-app)
  website        String?
  description    String?
  foundedYear    String?   @map("founded_year")
  specialties    String?
  linkedin       String?
  twitter        String?
  instagram      String?
  contactEmail   String?   @map("contact_email")
  contactPhone   String?   @map("contact_phone")
  contactPerson  String?   @map("contact_person")
  location       String?
  size           String?

  // Relations
  contacts       Contact[]
  leads          Lead[]
  deals          Deal[]

  @@map("accounts")
}

/// This model contains row level security.
model Contact {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName       String    @map("full_name")
  title          String?
  email          String?   @unique
  phone          String?
  accountId      String?   @map("account_id") @db.Uuid
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  role           String?
  location       String?
  department     String?
  reportsTo      String?   @map("reports_to")
  since          String?
  notes          String?
  ownerInitials  String?    @map("owner_initials")
  createdAt      DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")

  // Relations
  leads          Lead[]
  stakeholderIn  DealStakeholder[]

  @@map("contacts")
}

/// This model contains row level security.
model Lead {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String    @unique
  accountId       String?   @map("account_id") @db.Uuid
  account         Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId       String?   @map("contact_id") @db.Uuid
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  email           String?
  phone           String?
  company         String?
  jobTitle        String?   @map("job_title")
  industry        String?
  leadStatus      String    @default("NEW") @map("lead_status")
  serviceLine     String?   @map("service_line")
  deliveryFormat  String?   @map("delivery_format")
  value           String?
  probability     Int?      @default(0)
  dueDate         DateTime? @db.Date @map("due_date")
  ownerInitials   String?    @map("owner_initials")
  isFeatured      Boolean?  @default(false) @map("is_featured")
  description     String?
  practiceArea    String?   @map("practice_area")
  estimatedDuration Int?     @map("estimated_duration")
  source          String?   @default("Existing Client")
  practiceLeader  String?   @map("practice_leader")
  clientManager   String?   @map("client_manager")
  ownerId         String?   @map("owner_id")
  owner           User?     @relation(fields: [ownerId], references: [id])
  
  // Lead scoring & qualification
  leadScore       Int       @default(0) @map("lead_score")
  leadRating      String?   @map("lead_rating")    // HOT, WARM, COLD
  
  // BANT qualification fields
  hasBudget       Boolean   @default(false) @map("has_budget")
  hasAuthority    Boolean   @default(false) @map("has_authority")
  hasNeed         Boolean   @default(false) @map("has_need")
  hasTimeline     Boolean   @default(false) @map("has_timeline")
  
  // Conversion tracking
  isConverted     Boolean   @default(false) @map("is_converted")
  convertedDate   DateTime? @map("converted_date")
  convertedById   String?   @map("converted_by_id")
  convertedAccountId  String?  @map("converted_account_id") @db.Uuid
  convertedContactId  String?  @map("converted_contact_id") @db.Uuid
  convertedDealId     String?  @map("converted_deal_id") @db.Uuid
  
  createdAt       DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")

  // For relations
  activities       LeadActivity[]
  convertedDeal    Deal?          @relation(name: "LeadToDeal")

  @@map("leads")
}

// ==========================================
// NEW FEATURES FOR EXISTING TABLES
// ==========================================

model LeadAttachment {
  id           String   @id @default(cuid())
  leadId       String   @map("lead_id") @db.Uuid // Must match leads.id type
  fileName     String   @map("file_name")
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type")
  storageUrl   String   @map("storage_url")
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("lead_attachments")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id") @db.Uuid // Match leads.id
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id") // Optional for now
  user      User?    @relation(fields: [userId], references: [id])
  type      String   // CREATED, STAGE_CHANGED, ASSIGNED, ATTACHMENT_ADDED, EDITED
  fromValue String?  @map("from_value")
  toValue   String?  @map("to_value")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("lead_activity")
}

model SystemActivity {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  type      String   // LOGIN, ROLE_CHANGE, USER_SUSPENDED, SETTINGS_UPDATED
  targetId  String?  @map("target_id") 
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_activity")
}

model Deal {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String           @unique
  accountId           String?          @map("account_id") @db.Uuid
  account             Account?         @relation(fields: [accountId], references: [id])
  sourceLeadId        String?          @unique @map("source_lead_id") @db.Uuid
  sourceLead          Lead?            @relation(name: "LeadToDeal", fields: [sourceLeadId], references: [id])
  stage               String           // DISCOVERY, PROPOSAL, NEGOTIATION, CONTRACT, CLOSED_WON, CLOSED_LOST, ON_HOLD
  value               Decimal?         @db.Decimal(15, 2)
  probability         Int              @default(0)
  ownerId             String?          @map("owner_id")
  owner               User?            @relation(fields: [ownerId], references: [id])
  expectedCloseDate   DateTime?        @map("expected_close_date")
  description         String?
  nextStep            String?          @map("next_step")
  leadSource          String?          @map("lead_source")
  mrr                 Decimal?         @db.Decimal(15, 2)
  arr                 Decimal?         @db.Decimal(15, 2)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  activities          DealActivity[]
  documents           DealDocument[]
  competitors         DealCompetitor[]
  stakeholders        DealStakeholder[]

  @@map("deals")
}

model DealActivity {
  id        String   @id @default(cuid())
  dealId    String   @map("deal_id") @db.Uuid
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  type      String   // STAGE_CHANGE, NOTE, CALL, EMAIL, TASK
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("deal_activities")
}

model DealDocument {
  id           String   @id @default(cuid())
  dealId       String   @map("deal_id") @db.Uuid
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  title        String
  fileName     String   @map("file_name")
  fileSize     Int?     @map("file_size")
  mimeType     String?  @map("mime_type")
  storageUrl   String   @map("storage_url")
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("deal_documents")
}

model DealCompetitor {
  id        String  @id @default(cuid())
  dealId    String  @map("deal_id") @db.Uuid
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name      String
  strength  String?
  weakness  String?
  notes     String?

  @@map("deal_competitors")
}

model DealStakeholder {
  id        String   @id @default(cuid())
  dealId    String   @map("deal_id") @db.Uuid
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String   @map("contact_id") @db.Uuid
  contact   Contact  @relation(fields: [contactId], references: [id])
  role      String?  // CHAMPION, DECISION_MAKER, INFLUENCER, BLOCKER
  notes     String?

  @@map("deal_stakeholders")
}
